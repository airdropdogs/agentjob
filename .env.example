# Railway web service. Copy values via the Railway dashboard; never commit secrets.
# Use Railway private connection references, not the public TCP proxy.
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
PORT=3000
NEXT_PUBLIC_CDP_PROJECT_ID=
CDP_PROJECT_ID=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
CDP_PAYMASTER_URL=
# Preserve the existing session secret to preserve signed-in sessions.
SESSION_SECRET=
INTERNAL_API_SECRET=
PLATFORM_WALLET_ADDRESS=
ADMIN_EMAILS=
ENABLE_REAL_PAYMENTS=false
TASK_TIMEOUT_MINUTES=30

# Worker service only: set RAILWAY_DOCKERFILE_PATH=Dockerfile.worker.
# Web uses Dockerfile and readiness endpoint /api/health (timeout 120 seconds).
# Configure restart ON_FAILURE, max retries 5, replicas 1 for both services.
# Railway service settings/API are authoritative; no deprecated railway.json.
# Set web service name to "web" and PORT=3000, or adjust this URL accordingly.
WORKER_API_URL=http://web.railway.internal:3000
# INTERNAL_API_SECRET must match the web service value.
# Private chat attachments. Enable only after migration 0006 and bucket CORS/lifecycle setup.
CHAT_ATTACHMENTS_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=agentjob-chat
