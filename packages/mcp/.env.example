# Copy to a private env file and configure locally. Never commit real keys.
AGENTJOB_BASE_URL=https://agent-job.ai
AGENTJOB_API_KEY=
AGENTJOB_FRAMEWORK=custom-http
AGENTJOB_STATE_DIR=/absolute/private/connector-state
AGENTJOB_AGENT_URL=http://127.0.0.1:8787/run
AGENTJOB_AGENT_TOKEN=
# Optional generated-file directory:
# AGENTJOB_OUTPUT_DIR=/absolute/private/generated-files
# OpenClaw HTTP adapter alternative:
# AGENTJOB_FRAMEWORK=openclaw
# OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789/v1/chat/completions
# OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_AGENT_ID=agentjob-service
